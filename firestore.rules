rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the caller is the verified admin
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'romeelajutt23@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // User profile and points document (Wallet)
    match /users/{userId} {
      // Users can only read their own wallet document; Admin can read all users
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // New users must start at 0 current points; approvedBalanceUSD must be 0
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.points == 0 &&
        (!('approvedBalanceUSD' in request.resource.data) || request.resource.data.approvedBalanceUSD <= 0) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'member');

      // Users can update their document:
      // 1. Role cannot be elevated to admin
      // 2. approvedBalanceUSD CANNOT be modified by users (only admin/cloud system on published months)
      // 3. publishedMonthsCredited CANNOT be modified by users
      // 4. isExcludedFromPool CANNOT be modified by users
      // 5. pointsResetMigrationId / pointsResetAt CANNOT be tampered with by non-admin users
      // 6. Points can only increase by at most 50 pts per verified transaction (eligible activity +1 or verified referral +50) or decrease
      // 7. Streak can only increase by at most 1 day per update
      allow update: if request.auth != null &&
        (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
            (!('approvedBalanceUSD' in request.resource.data) || request.resource.data.approvedBalanceUSD == resource.data.approvedBalanceUSD) &&
            (!('publishedMonthsCredited' in request.resource.data) || request.resource.data.publishedMonthsCredited == resource.data.publishedMonthsCredited) &&
            (!('isExcludedFromPool' in request.resource.data) || request.resource.data.isExcludedFromPool == resource.data.isExcludedFromPool) &&
            (!('pointsResetMigrationId' in request.resource.data) || request.resource.data.pointsResetMigrationId == resource.data.pointsResetMigrationId) &&
            (
              // Points reduction (e.g. conversion or perk spend)
              request.resource.data.points <= resource.data.points ||
              // Strict per-update cap (+1 eligible activity or +50 verified referral)
              (request.resource.data.points - resource.data.points <= 50)
            ) &&
            (
              !('streakDays' in request.resource.data) ||
              !('streakDays' in resource.data) ||
              request.resource.data.streakDays <= resource.data.streakDays + 1
            )
          )
        );

      // Users can delete their own profile data (account deletion)
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Subcollection for points claims audit log
      match /claims/{claimId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false; // Immutable audit log
      }

      // Subcollection for completed daily tasks: exactly 1 write per task per day per user
      match /completed_tasks/{taskRecordId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.userId == userId &&
          request.resource.data.taskId in ['daily_checkin', 'daily_quiz', 'daily_video', 'daily_wheel', 'daily_chest'];
        allow update, delete: if false; // Once recorded for today, cannot be rewritten
      }

      // Subcollection for daily 100% completion summaries
      match /daily_summaries/{dateStr} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.userId == userId &&
          request.resource.data.date == dateStr;
        allow delete: if false;
      }

      // Immutable Reward Ledger (unique txId prevents duplicate rewards forever)
      match /reward_ledger/{txId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            request.resource.data.uid == userId &&
            request.resource.data.txId == txId &&
            request.resource.data.points is int &&
            request.resource.data.points >= -500000 &&
            request.resource.data.points <= 2500 &&
            request.resource.data.reason is string &&
            request.resource.data.reason.size() > 0 &&
            request.resource.data.reason.size() <= 200
          )
        );
        allow update, delete: if false;
      }

      // Immutable Reconciliation & Points Recovery Audit Log
      match /reconciliation_logs/{logId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow update, delete: if false;
      }

      // Daily Learning Streak state & completed calendar dates per user
      match /learning_streak/{docId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.uid == userId;
        allow delete: if false;
      }

      // Notification Control Center preferences per user
      match /notification_settings/{docId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.uid == userId;
        allow delete: if false;
      }

      // App Preferences (Data Saver & Video Quality settings) per user
      match /app_preferences/{docId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.uid == userId;
        allow delete: if false;
      }

      // Active Device Sessions (strictly private to account owner — never readable by other users)
      match /sessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.uid == userId &&
          request.resource.data.sessionId == sessionId;
        allow delete: if false;
      }

      // Immutable Account Security & Login Activity Log (strictly private to account owner)
      match /security_events/{eventId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.uid == userId;
        allow update, delete: if false;
      }

      // Offline Learning Mode: synced lesson completions per user (conflict-free merge)
      match /offline_learning_progress/{packId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.uid == userId &&
          request.resource.data.packId == packId;
        allow delete: if false;
      }
    }

    // Monthly community prize pool & received funds metrics
    // Only verified admin can change months, pool, funds received, or publish
    match /monthly_pools/{monthYear} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Welcome bonus collection: strictly 1 claim per Google account
    match /welcome_bonuses/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false; // Immutable once claimed
    }

    // Withdrawals collection
    match /withdrawals/{withdrawalId} {
      // User can only read their own withdrawals; Admin can read all withdrawals
      allow read: if request.auth != null && (
        resource.data.userUid == request.auth.uid ||
        isAdmin()
      );

      // User creates withdrawal request from approvedBalanceUSD:
      // Minimum: $100 USD (or 100,000 pts legacy)
      // Maximum per request: $500 USD (or 500,000 pts legacy)
      // Status must initially be 'Submitted' (or 'Pending' for legacy compatibility)
      allow create: if request.auth != null &&
        request.resource.data.userUid == request.auth.uid &&
        (
          (request.resource.data.cashAmount >= 100 && request.resource.data.cashAmount <= 500) ||
          (request.resource.data.points >= 100000 && request.resource.data.points <= 500000)
        ) &&
        request.resource.data.status in ['Submitted', 'Pending'] &&
        request.resource.data.paymentMethod in ['Easypaisa', 'JazzCash', 'PayPal', 'Bank transfer', 'Bank'] &&
        request.resource.data.accountDetails is string &&
        request.resource.data.accountDetails.size() >= 5 &&
        request.resource.data.accountDetails.size() <= 100 &&
        request.resource.data.accountName is string &&
        request.resource.data.accountName.size() >= 2;

      // Users can NEVER edit a withdrawal after creating it.
      // Only the verified admin can update payout status (Submitted, Under review, Verified, Paid, Rejected).
      allow update: if isAdmin();

      // No deletion of processed withdrawals allowed
      allow delete: if false;
    }

    // Sponsor Ads: Everyone can read active ads, only verified admin can manage ads
    match /sponsor_ads/{adId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // App Configuration (e.g. rotation launch date)
    // Anyone can read; only admin can create, update, or delete
    match /config/{configDoc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Safety and content reports collection
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Sponsor Enquiries
    match /sponsor_enquiries/{enquiryId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.businessName is string &&
        request.resource.data.businessName.size() > 0 &&
        request.resource.data.businessName.size() <= 150 &&
        request.resource.data.websiteLink is string &&
        request.resource.data.websiteLink.size() <= 300 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 100 &&
        (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 50)) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.package in ['Starter', 'Basic', 'Standard', 'Premium', 'Mega'] &&
        (!('languageOption' in request.resource.data) || request.resource.data.languageOption in ['English', 'Urdu', 'both']) &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    // Videos collection for Admin management
    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Sponsor Requests: Anyone can submit a sponsor lead; only admin can read, update, or delete
    match /sponsor_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Custom Quiz Questions
    match /custom_quiz_questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Connectivity check document (read-only)
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Weekly Challenge Leaderboard
    match /weekly_challenges/{weekKey}/entries/{entryId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == entryId;
      allow delete: if isAdmin();
    }

    // Community Vlogs collection (supports both Cloud Storage video uploads and YouTube vlogs)
    match /vlogs/{vlogId} {
      // Approved vlogs with < 3 reports are public; creators can read their own submissions; admin can read all
      allow read: if (resource.data.status == 'approved' && (!('reportCount' in resource.data) || resource.data.reportCount < 3)) ||
                     (request.auth != null && resource.data.uid == request.auth.uid) ||
                     isAdmin();

      // Signed-in users can publish a cloud-hosted video (videoUrl) or submit a YouTube vlog (videoId)
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status in ['approved', 'pending'] &&
        request.resource.data.reportCount == 0 &&
        (!('likeCount' in request.resource.data) || request.resource.data.likeCount == 0) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 400)) &&
        (
          (request.resource.data.videoUrl is string && request.resource.data.videoUrl.matches('^https://.*')) ||
          (request.resource.data.videoId is string && request.resource.data.videoId.size() == 11)
        ) &&
        request.resource.data.category in ['cooking', 'gardening', 'home and family', 'health', 'nature', 'learning', 'travel', 'funny and wholesome', 'other'];

      // Updates: Admin can update any field; users can report (reportCount + 1) or like/unlike (likeCount +/- 1)
      allow update: if isAdmin() ||
        (
          // Allow reporting a vlog: only reportCount changes
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount']) &&
          request.resource.data.reportCount == (('reportCount' in resource.data ? resource.data.reportCount : 0) + 1)
        ) ||
        (
          // Allow signed-in users to increment or decrement likeCount by exactly 1
          request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']) &&
          request.resource.data.likeCount is int &&
          request.resource.data.likeCount >= 0 &&
          (
            request.resource.data.likeCount == (('likeCount' in resource.data ? resource.data.likeCount : 0) + 1) ||
            request.resource.data.likeCount == (('likeCount' in resource.data ? resource.data.likeCount : 0) - 1)
          )
        );

      // Deletions: Admin or the vlog's creator
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);

      // Per-account likes subcollection (prevents duplicate likes across devices)
      match /likes/{userId} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }
    }

    // Community Vlog Reports collection
    match /vlog_reports/{reportId} {
      // Anyone can submit a report
      allow create: if request.resource.data.vlogId is string &&
                       request.resource.data.reason in ['inappropriate clothing or content', 'offensive language', 'copyright', 'spam', 'other'];
      allow read, update, delete: if isAdmin();
    }

    // Blocked Creators collection
    match /blocked_creators/{creatorUid} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Unique Referral Codes directory (maps code -> referrerUid)
    match /referral_codes/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.resource.data.referrerUid == request.auth.uid &&
        request.resource.data.code == code;
      allow delete: if false;
    }

    // Verified Referrals collection (1 immutable document per referred user UID)
    // Blocks self-referrals, duplicate accounts, and reward tampering
    match /referrals/{referredUid} {
      allow read: if request.auth != null && (
        request.auth.uid == referredUid ||
        resource.data.referrerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null &&
        request.auth.uid == referredUid &&
        request.resource.data.referredUid == referredUid &&
        request.resource.data.referrerUid is string &&
        request.resource.data.referrerUid != request.auth.uid &&
        request.resource.data.rewardPoints == 50 &&
        request.resource.data.status == 'verified' &&
        request.resource.data.creditedToReferrer == false;
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          resource.data.referrerUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creditedToReferrer', 'creditedAt']) &&
          request.resource.data.creditedToReferrer == true
        )
      );
      allow delete: if false;
    }

    // Controlled Migration Backups (strictly owner-only read/write, never deletable)
    match /migration_backups/{migrationId}/users/{userId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
